"3142","3143"],["3144","3145"],["3146","3147"],["3148","3149"],["3150","3151"],["3152","3153"],["3154"],{"range":"3155","text":"2682"},"Delete `⏎⏎······`",{"range":"3156","text":"2682"},["3157","3158"],{"range":"3159","text":"2682"},["3160","3161"],["3162","3163"],{"range":"3164","text":"2682"},{"range":"3165","text":"2682"},{"range":"3166","text":"2682"},{"range":"3167","text":"2682"},["3168","3169"],["3170","3171"],"Insert `⏎`",{"range":"3172","text":"3173"},["3174","3175"],["3176","3177"],["3178","3179"],["3180","3181"],["3182","3183"],["3184"],["3185","3186"],["3187"],"Delete `⏎··`",{"range":"3188","text":"2682"},"'allFiles' is never reassigned. Use 'const' instead.",{"range":"3189","text":"3190"},["3191","3192"],["3193","3194"],"'apiError' is defined but never used. Allowed unused caught errors must match /^_/u.",["3195","3196"],["3197","3198"],["3199","3200"],["3201"],["3202","3203"],["3204","3205"],["3206","3207"],["3208","3209"],["3210","3211"],["3212","3213"],["3214","3215"],["3216"],{"range":"3217","text":"2682"},"Replace `\"./IndexRoot\"` with `'./IndexRoot'`",{"range":"3218","text":"3219"},{"range":"3220","text":"2682"},["3221","3222"],["3223","3224"],["3225","3226"],["3227","3228"],["3229","3230"],["3231","3232"],"'sequence' is never reassigned. Use 'const' instead.",{"range":"3233","text":"3234"},{"range":"3235","text":"2682"},["3236","3237"],"'queue' is never reassigned. Use 'const' instead.",{"range":"3238","text":"3239"},["3240","3241"],"'visited' is never reassigned. Use 'const' instead.",{"range":"3242","text":"3243"},"'currentNode' is never reassigned. Use 'const' instead.",{"range":"3244","text":"3245"},["3246","3247"],["3248","3249"],["3250","3251"],["3252","3253"],["3254","3255"],["3256"],{"range":"3257","text":"2682"},"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\MacroManagementMenu.tsx:30:21\n  28 |\n  29 |   useEffect(() => {\n> 30 |     if (isMainOpen) loadWorkflowsList()\n     |                     ^^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  31 |   }, [isMainOpen])\n  32 |\n  33 |   useEffect(() => {",["3258","3259"],["3260","3261"],["3262","3263"],["3264","3265"],["3266","3267"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\MiniOverlay.tsx:53:7\n  51 |       checkAudio()\n  52 |     } else {\n> 53 |       setIsTalking(false)\n     |       ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  54 |     }\n  55 |   }, [isSystemActive])\n  56 |",{"range":"3268","text":"2682"},["3269","3270"],["3271","3272"],"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\ParameterEditorDrawer.tsx:184:7\n  182 |   useEffect(() => {\n  183 |     if (nodeData) {\n> 184 |       setLocalInputs(nodeData.data.inputs || {})\n      |       ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  185 |       setLocalComment(nodeData.data.comment || '')\n  186 |     }\n  187 |   }, [nodeData])",["3273","3274"],["3275","3276"],"react/prop-types","'count' is missing in props validation","Property","missingPropType","react-hooks/purity","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\Sphere.tsx:17:17\n  15 |\n  16 |     for (let i = 0; i < count; i++) {\n> 17 |       const x = Math.random() * 2 - 1\n     |                 ^^^^^^^^^^^^^ Cannot call impure function\n  18 |       const y = Math.random() * 2 - 1\n  19 |       const z = Math.random() * 2 - 1\n  20 |","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\Sphere.tsx:18:17\n  16 |     for (let i = 0; i < count; i++) {\n  17 |       const x = Math.random() * 2 - 1\n> 18 |       const y = Math.random() * 2 - 1\n     |                 ^^^^^^^^^^^^^ Cannot call impure function\n  19 |       const z = Math.random() * 2 - 1\n  20 |\n  21 |       const vector = new THREE.Vector3(x, y, z)","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\Sphere.tsx:19:17\n  17 |       const x = Math.random() * 2 - 1\n  18 |       const y = Math.random() * 2 - 1\n> 19 |       const z = Math.random() * 2 - 1\n     |                 ^^^^^^^^^^^^^ Cannot call impure function\n  20 |\n  21 |       const vector = new THREE.Vector3(x, y, z)\n  22 |       vector.normalize().multiplyScalar(2)","Error: Cannot call impure function during render\n\n`Math.random` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\Sphere.tsx:32:19\n  30 |       orig[i * 3 + 2] = vector.z\n  31 |\n> 32 |       spread[i] = Math.random()\n     |                   ^^^^^^^^^^^^^ Cannot call impure function\n  33 |     }\n  34 |     return { positions: pos, originalPositions: orig, spreadFactors: spread }\n  35 |   }, [count])",{"range":"3277","text":"2682"},{"range":"3278","text":"2682"},"Delete `0`",{"range":"3279","text":"2682"},"react/no-unknown-property","Unknown property 'attach' found","JSXAttribute","unknownProp","Unknown property 'count' found","Unknown property 'array' found","Unknown property 'itemSize' found","Unknown property 'args' found","Unknown property 'transparent' found","Unknown property 'sizeAttenuation' found","Unknown property 'blending' found","Unknown property 'intensity' found",{"range":"3280","text":"2682"},{"range":"3281","text":"2682"},{"range":"3282","text":"2682"},["3283"],["3284"],{"range":"3285","text":"2682"},{"range":"3286","text":"2682"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\components\\Titlebar.tsx:15:7\n  13 |   useEffect(() => {\n  14 |     if (window.electron && window.electron.process) {\n> 15 |       setIsMac(window.electron.process.platform === 'darwin')\n     |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  16 |     } else {\n  17 |       setIsMac(navigator.userAgent.toLowerCase().includes('mac'))\n  18 |     }",{"range":"3287","text":"2682"},{"range":"3288","text":"2682"},{"range":"3289","text":"2682"},"react-refresh/only-export-components","Fast refresh only works when a file only exports components. Use a new file to share constants or functions between components.","namedExport",["3290","3291"],["3292","3293"],["3294","3295"],["3296","3297"],{"range":"3298","text":"2682"},["3299","3300"],["3301","3302"],{"range":"3303","text":"2682"},{"range":"3304","text":"3173"},{"range":"3305","text":"2682"},["3306","3307"],["3308","3309"],{"range":"3310","text":"3173"},["3311","3312"],{"range":"3313","text":"2682"},{"range":"3314","text":"2682"},"Delete `⏎⏎·`",{"range":"3315","text":"2682"},{"range":"3316","text":"2682"},{"range":"3317","text":"2682"},{"range":"3318","text":"3173"},"react-hooks/immutability","Error: Cannot access variable before it is declared\n\n`stopVision` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\IndexRoot.tsx:48:9\n  46 |         setIsSystemActive(false)\n  47 |         setIsMicMuted(true)\n> 48 |         stopVision()\n     |         ^^^^^^^^^^ `stopVision` accessed before it is declared\n  49 |       }\n  50 |     }, 1000)\n  51 |     return () => clearInterval(watchdog)\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\IndexRoot.tsx:133:3\n  131 |   }\n  132 |\n> 133 |   const stopVision = () => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 134 |     setIsVideoOn(false)\n      | ^^^^^^^^^^^^^^^^^^^^^^^\n> 135 |     setVisionMode('none')\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^\n> 149 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^\n> 150 |   }\n      | ^^^^ `stopVision` is declared here\n  151 |\n  152 |   const startAIProcessing = () => {\n  153 |     if (aiIntervalRef.current) clearInterval(aiIntervalRef.current)",["3319","3320"],"@typescript-eslint/ban-ts-comment","Include a description after the \"@ts-ignore\" directive to explain why the @ts-ignore is necessary. The description must be 3 characters or longer.","Line","tsDirectiveCommentRequiresDescription",["3321","3322"],["3323","3324"],["3325","3326"],"Fast refresh only works when a file has exports. Move your component(s) to a separate file.","noExport","Delete `··········⏎⏎`",{"range":"3327","text":"2682"},["3328","3329"],["3330"],{"range":"3331","text":"2682"},{"range":"3332","text":"2682"},["3333","3334"],{"range":"3335","text":"2682"},["3336"],"'cloudUser' is never reassigned. Use 'const' instead.",{"range":"3337","text":"3338"},["3339"],"Delete `⏎······⏎····`",{"range":"3340","text":"2682"},["3341","3342"],["3343","3344"],{"range":"3345","text":"2682"},["3346","3347"],"no-dupe-else-if","This branch can never execute. Its condition is a duplicate or covered by previous conditions in the if-else-if chain.","BinaryExpression",{"range":"3348","text":"2682"},"'stepError' is defined but never used. Allowed unused caught errors must match /^_/u.",["3349","3350"],["3351"],"Delete `⏎······`",{"range":"3352","text":"2682"},["3353","3354"],{"range":"3355","text":"2682"},{"range":"3356","text":"2682"},{"range":"3357","text":"2682"},{"range":"3358","text":"2682"},{"range":"3359","text":"2682"},{"range":"3360","text":"2682"},{"range":"3361","text":"2682"},{"range":"3362","text":"2682"},{"range":"3363","text":"2682"},{"range":"3364","text":"2682"},["3365","3366"],{"range":"3367","text":"2682"},["3368","3369"],{"range":"3370","text":"2682"},["3371","3372"],{"range":"3373","text":"2682"},["3374","3375"],{"range":"3376","text":"2682"},{"range":"3377","text":"2682"},{"range":"3378","text":"2682"},["3379","3380"],{"range":"3381","text":"2682"},{"range":"3382","text":"2682"},"Replace `'start-council-session',·get().task,·agents);` with `⏎······'start-council-session',⏎······get().task,⏎······agents⏎····