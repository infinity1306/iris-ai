509"],"'isSystemActive' is missing in props validation","'isVideoOn' is missing in props validation","'visionMode' is missing in props validation","'startVision' is missing in props validation","'activeStream' is missing in props validation","'toggleMic' is missing in props validation","'toggleSystem' is missing in props validation","'isMicMuted' is missing in props validation",["3510"],{"range":"3511","text":"2682"},{"range":"3512","text":"2682"},{"range":"3513","text":"2682"},{"range":"3514","text":"2682"},["3515"],{"range":"3516","text":"2682"},"React Hook useCallback has an unnecessary dependency: 'visionMode'. Either exclude it or remove the dependency array.",["3517"],["3518"],["3519"],{"range":"3520","text":"2682"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\views\\Gallery.tsx:56:5\n  54 |\n  55 |   useEffect(() => {\n> 56 |     fetchGallery()\n     |     ^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  57 |     const interval = setInterval(fetchGallery, 5000)\n  58 |     return () => clearInterval(interval)\n  59 |   }, [])","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\views\\Gallery.tsx:63:5\n  61 |   useEffect(() => {\n  62 |     const endIndex = page * ITEMS_PER_PAGE\n> 63 |     setVisibleImages(allImages.slice(0, endIndex))\n     |     ^^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  64 |   }, [page, allImages])\n  65 |\n  66 |",{"range":"3521","text":"2682"},{"range":"3522","text":"2682"},{"range":"3523","text":"2682"},{"range":"3524","text":"2682"},"'node' is defined but never used. Allowed unused args must match /^_/u.","'className' is defined but never used. Allowed unused args must match /^_/u.",["3525","3526"],["3527"],{"range":"3528","text":"2682"},"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\views\\Notes.tsx:57:5\n  55 |\n  56 |   useEffect(() => {\n> 57 |     fetchNotes()\n     |     ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  58 |     const interval = setInterval(fetchNotes, 3000) \n  59 |     return () => clearInterval(interval)\n  60 |   }, [])",{"range":"3529","text":"2682"},{"range":"3530","text":"2682"},{"range":"3531","text":"2682"},["3532","3533"],"Error: Cannot access variable before it is declared\n\n`connectToDevice` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\views\\Phone.tsx:52:11\n  50 |           setIp(lastDevice.ip)\n  51 |           setPort(lastDevice.port)\n> 52 |           connectToDevice(lastDevice.ip, lastDevice.port)\n     |           ^^^^^^^^^^^^^^^ `connectToDevice` accessed before it is declared\n  53 |         }\n  54 |       }\n  55 |     })\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\views\\Phone.tsx:84:3\n   82 |   }\n   83 |\n>  84 |   const connectToDevice = async (targetIp: string, targetPort: string) => {\n      |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  85 |     if (!targetIp || !targetPort) return setErrorMsg('IP and Port are required.')\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n>  86 |     setStatus('connecting')\n      …\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 106 |     }\n      | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 107 |   }\n      | ^^^^ `connectToDevice` is declared here\n  108 |\n  109 |   const handleManualConnect = () => {\n  110 |     localStorage.setItem('iris_adb_ip', ip)","React Hook useEffect has a missing dependency: 'connectToDevice'. Either include it or remove the dependency array.",["3534"],["3535"],{"range":"3536","text":"2682"},["3537"],["3538"],["3539"],["3540"],["3541","3542"],["3543"],{"range":"3544","text":"2682"},["3545","3546"],["3547","3548"],"'isSaved' is assigned a value but never used. Allowed unused vars must match /^_/u.",["3549","3550"],["3551","3552"],["3553","3554"],["3555","3556"],["3557","3558"],["3559","3560"],["3561","3562"],["3563"],["3564"],{"range":"3565","text":"2682"},{"range":"3566","text":"2682"},["3567"],["3568","3569"],["3570","3571"],"Delete `⏎⏎·······`",{"range":"3572","text":"2682"},["3573","3574"],["3575","3576"],["3577"],{"range":"3578","text":"2682"},["3579","3580"],"'React' is defined but never used. Allowed unused vars must match /^_/u.",["3581"],{"range":"3582","text":"2682"},{"range":"3583","text":"2682"},{"range":"3584","text":"2682"},{"range":"3585","text":"2682"},{"range":"3586","text":"2682"},"Replace `·setIsOpen,·task,·setTask,·startSession,·` with `⏎····setIsOpen,⏎····task,⏎····setTask,⏎····startSession,`",{"range":"3587","text":"3588"},"Replace `·events,·finalPlan,·status,·approveExecution·` with `⏎····events,⏎····finalPlan,⏎····status,⏎····approveExecution`",{"range":"3589","text":"3590"},{"range":"3591","text":"2682"},{"range":"3592","text":"2682"},{"range":"3593","text":"2682"},{"range":"3594","text":"2682"},{"range":"3595","text":"2682"},{"range":"3596","text":"2682"},"Replace `STATUS:·{status.toUpperCase()}` with `⏎··············STATUS:·{status.toUpperCase()}⏎············`",{"range":"3597","text":"3598"},{"range":"3599","text":"2682"},{"range":"3600","text":"2682"},"Replace `·key={agent.id}·className=\"bg-zinc-900/50·border·border-emerald-500/20·rounded-lg·p-3·h-64·flex·flex-col\"` with `⏎··················key={agent.id}⏎··················className=\"bg-zinc-900/50·border·border-emerald-500/20·rounded-lg·p-3·h-64·flex·flex-col\"⏎················`",{"range":"3601","text":"3602"},"Replace `Agent·{agent.id.slice(0,6)}` with `⏎····················Agent·{agent.id.slice(0,·6)}⏎··················`",{"range":"3603","text":"3604"},"Replace `Implementation·Plan` with `⏎··············Implementation·Plan⏎············`",{"range":"3605","text":"3606"},"Replace `{JSON.stringify(finalPlan,·null,·2)}` with `⏎··················{JSON.stringify(finalPlan,·null,·2)}⏎················`",{"range":"3607","text":"3608"},"Replace `Waiting·for·Judge·Decision...` with `⏎··················Waiting·for·Judge·Decision...⏎················`",{"range":"3609","text":"3610"},{"range":"3611","text":"2682"},"Replace `Event·Stream` with `⏎············Event·Stream⏎··········`",{"range":"3612","text":"3613"},"Replace `[{new·Date(ev.timestamp).toISOString().split('T')[1]}]` with `⏎··················[{new·Date(ev.timestamp).toISOString().split('T')[1]}]⏎················`",{"range":"3614","text":"3615"},"Replace `{ev.agentId·?·`(Agent:·${ev.agentId.slice(0,6)})`·:·''}` with `⏎··················{ev.agentId·?·`(Agent:·${ev.agentId.slice(0,·6)})`·:·''}⏎················`",{"range":"3616","text":"3617"},{"range":"3618","text":"2682"},{"range":"3619","text":"2682"},{"range":"3620","text":"2682"},{"range":"3621","text":"2682"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\DeepResearch.tsx:23:35\n  21 |   const { contextSafe } = useGSAP({ scope: containerRef })\n  22 |\n> 23 |   const handleStart = contextSafe((e: any) => {\n     |                                   ^^^^^^^^^^^^^\n> 24 |     setQuery(e.detail.query)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 25 |     setIsSuccess(null)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 26 |     setSummary('')\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 27 |     setIsOpen(true)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 28 |     setStatusText('Booting Deep Search Node...')\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 29 |     if (progressRef.current) gsap.to(progressRef.current, { width: '5%', duration: 0.5 })\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 30 |   })\n     | ^^^^ Passing a ref to a function may read its value during render\n  31 |\n  32 |   const handleProgress = contextSafe(\n  33 |     (_event: any, data: { status: string; file: string; totalFound: number }) => {",["3622","3623"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\DeepResearch.tsx:33:5\n  31 |\n  32 |   const handleProgress = contextSafe(\n> 33 |     (_event: any, data: { status: string; file: string; totalFound: number }) => {\n     |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 34 |       if (textRef.current) {\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 35 |         gsap.to(textRef.current, {\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 48 |       }\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 49 |     }\n     | ^^^^^^ Passing a ref to a function may read its value during render\n  50 |   )\n  51 |\n  52 |   const handleDone = contextSafe((e: any) => {",["3624","3625"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\DeepResearch.tsx:52:34\n  50 |   )\n  51 |\n> 52 |   const handleDone = contextSafe((e: any) => {\n     |                                  ^^^^^^^^^^^^^\n> 53 |     const success = e.detail.success\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 54 |     setIsSuccess(success)\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 87 |     setTimeout(() => setIsOpen(false), 6000)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 88 |   })\n     | ^^^^ Passing a ref to a function may read its value during render\n  89 |\n  90 |   useEffect(() => {\n  91 |     window.addEventListener('deep-research-start', handleStart)",["3626","3627"],["3628","3629"],{"range":"3630","text":"2682"},["3631","3632"],["3633","3634"],["3635","3636"],["3637","3638"],["3639","3640"],["3641","3642"],["3643","3644"],["3645","3646"],["3647","3648"],["3649","3650"],["3651","3652"],["3653","3654"],["3655","3656"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\SematicSearch.tsx:21:35\n  19 |   const { contextSafe } = useGSAP({ scope: containerRef })\n  20 |\n> 21 |   const handleStart = contextSafe((e: any) => {\n     |                                   ^^^^^^^^^^^^^\n> 22 |     setTarget(e.detail.target)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 23 |     setIsSuccess(null)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 24 |     setIsOpen(true)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 25 |     setStatusText('Waking Llama 3.1 Neural Core...')\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 26 |     if (progressRef.current) gsap.to(progressRef.current, { width: '5%', duration: 0.5 })\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 27 |   })\n     | ^^^^ Passing a ref to a function may read its value during render\n  28 |\n  29 |   const handleProgress = contextSafe(\n  30 |     (_event: any, data: { status: string; text: string; progress: number }) => {",["3657","3658"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\SematicSearch.tsx:30:5\n  28 |\n  29 |   const handleProgress = contextSafe(\n> 30 |     (_event: any, data: { status: string; text: string; progress: number }) => {\n     |     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 31 |       if (textRef.current) {\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 32 |         gsap.to(textRef.current, {\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 47 |         })\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 48 |     }\n     | ^^^^^^ Passing a ref to a function may read its value during render\n  49 |   )\n  50 |\n  51 |   const handleDone = contextSafe((e: any) => {",["3659","3660"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\SematicSearch.tsx:51:34\n  49 |   )\n  50 |\n> 51 |   const handleDone = contextSafe((e: any) => {\n     |                                  ^^^^^^^^^^^^^\n> 52 |     const success = e.detail.success\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 53 |     setIsSuccess(success)\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 71 |     setTimeout(() => setIsOpen(false), 4000)\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 72 |   })\n     | ^^^^ Passing a ref to a function may read its value during render\n  73 |\n  74 |   useEffect(() => {\n  75 |     window.addEventListener('semantic-start', handleStart)",["3661","3662"],["3663","3664"],["3665","3666"],["3667","3668"],["3669","3670"],["3671","3672"],["3673","3674"],"react-hooks/static-components","Error: Cannot create components during render\n\nComponents created during render will reset their state each time they are created. Declare components outside of render.\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\StockWidget.tsx:146:34\n  144 |                 </linearGradient>\n  145 |               </defs>\n> 146 |               <Tooltip content={<CustomTooltip />} />\n      |                                  ^^^^^^^^^^^^^ This component is created during render\n  147 |               <YAxis yAxisId=\"left\" domain={['auto', 'auto']} hide />\n  148 |               {stock.isComparison && (\n  149 |                 <YAxis yAxisId=\"right\" orientation=\"right\" domain={['auto', 'auto']} hide />\n\nC:\\Users\\youri\\OneDrive\\Desktop\\IRIS-AI-main\\IRIS-AI-main\\src\\renderer\\src\\Widgets\\StockWidget.tsx:30:25\n  28 |   const c2 = stock.isPositive2 ? '#3b82f6' : '#f59e0b'\n  29 |\n> 30 |   const CustomTooltip = ({ active, payload, label }: any) => {\n     |                         ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 31 |     if (active && payload && payload.length) {\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 32 |       return (\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 54 |     return null\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 55 |   }\n     | ^^^^ The component is created during render here\n  56 |\n  57 |   return (\n  58 |     <div className=\"fixed inset-0 z-9650 flex items-center justify-center p-10 bg-black/80 backdrop-blur-sm animate-in fade-in duration-500\">",["3675","3676"],["3677","3678"],[453,454],"",[1167,1169],[4873,4944],"const cleanCode = fullCode.replace(/^```html\\n?/, '').replace(/```$/, '')",[34,35],[124,125],[182,183],[219,220],[282,283],[385,386],[413,414],[476,477],[566,567],[636,637],[703,704],[788,789],[922,923],[1050,1051],"(c)",[1434,1435],[1484,1485],[1581,1582],[1676,1680],"((err)",[1703,1796],"\n        sessionId,\n        timestamp: Date.now(),\n        type: 'SessionFailed',\n        payload: { error: err.message }\n      })",[1828,1829],[1836,1837],[1859,1860],[1968,1969],[2053,2054],[2055,2059],[2092,2093],[2109,2210],"\n      sessionId,\n      timestamp: Date.now(),\n      type: 'ExecutionStarted',\n      payload: { plan: session.finalPlan }\n    })",[2289,2290],[2363,2364],[2382,2468],"\n        sessionId,\n        timestamp: Date.now(),\n        type: 'ExecutionCompleted',\n        payload: { result }\n      })",[2503,2504],{"messageId":"3679","fix":"3680","desc":"3681"},{"messageId":"3682","fix":"3683","desc":"3684"},[2547,2640],[2672,2673],[2795,2796],[2821,2822],[2872,2897],"(a) => a.role !== 'judge')",[2940,2966],"((a) => a.role === 'judge')",[3056,3057],[3080,3109],"\n      workingAgents.map(async (agent)",[3115,3145],"        agent.status = 'active'",[3146,3241],"        this.emit({ sessionId, timestamp: Date.now(), type: 'AgentStarted', agentId: agent.id })",[3242,3242],"  ",[3254,3329],"          const provider = new VercelAIProvider(agent.provider, agent.model)",[3330,3530],"          const prompt = `You are an elite AI ${agent.role}. Analyze the following task: \"${session.task}\". Provide a diagnosis, proposed solution, likely changed files, risks, and a confidence score.`",[3531,3564],"\n          let output = ''",[3565,3565],[3666,3682],"  output += chunk",[3683,3814],"  